# Backend environment variables.
# Copy this file to ".env" in the same folder and fill in real values.
# The real .env is gitignored — never commit it.

# --- MySQL database connection ---
# The shared TEAM database is on Aiven (cloud). Ask a teammate for the host/user/password.
#   Aiven (shared): DB_HOST=<svc>-<proj>.<...>.aivencloud.com  DB_PORT=<port>  DB_USER=avnadmin  DB_NAME=defaultdb  DB_SSL=true
#   Local MySQL:    DB_HOST=localhost  DB_PORT=3306  DB_USER=root  DB_NAME=bookingapp_db  DB_SSL=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=bookingapp_db
DB_SSL=false

# --- Server ---
PORT=5000

# --- JWT authentication ---
# Use a long, random string for the secret (e.g. 32+ characters).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# --- Payments (optional: the API starts without them; the matching pay option just won't work) ---
# PayPal (sandbox credentials from developer.paypal.com)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Stripe (test secret key from dashboard.stripe.com; publishable key lives in frontend/src/app/core/stripe.config.ts)
STRIPE_SECRET_KEY=
# Only used if a booking has no stored price
STRIPE_TEST_AMOUNT_CENTS=1000
